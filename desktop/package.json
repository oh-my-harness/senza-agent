{
  "name": "senza-agent-desktop",
  "version": "0.1.0",
  "description": "senza-agent Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.senzaagent.desktop",
    "productName": "SenzaAgent",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}

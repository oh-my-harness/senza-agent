{
  "name": "senza-agent-desktop",
  "version": "0.1.0",
  "description": "senza-agent Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.senzaagent.desktop",
    "productName": "SenzaAgent",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../senza_agent",
        "to": "senza_agent",
        "filter": ["**/*", "!__pycache__/**", "!**/*.pyc"]
      },
      {
        "from": "../pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../SKILLS",
        "to": "SKILLS"
      },
      {
        "from": "../AGENTS.md",
        "to": "AGENTS.md"
      },
      {
        "from": "setup_python.ps1",
        "to": "setup_python.ps1"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SenzaAgent",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}
